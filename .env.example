NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/nexora
CORS_ORIGIN=http://localhost:3000
# Required before accounts are introduced; use a long random value in production.
JWT_SECRET=replace-with-a-long-random-secret
# Shared only with the Vercel server. Never expose this value to the browser.
ADMIN_API_KEY=replace-with-a-long-random-admin-api-key
